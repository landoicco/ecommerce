{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(aws *)",
      "Bash(terraform *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 120,
            "statusMessage": "Formatting edited file"
          }
        ]
      }
    ]
  }
}
